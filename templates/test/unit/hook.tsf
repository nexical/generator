import { fragment } from '@nexical/generator';

declare const hookPath: string;
declare const hookName: string;

export default fragment/* ts */`
import { describe, it, expect, vi } from 'vitest';
import { init } from '${hookPath}';
import { HookSystem } from '@/lib/modules/hooks';

 vi.mock('@/lib/modules/hooks', () => ({
    HookSystem: {
        on: vi.fn(),
        filter: vi.fn(),
    },
}));

describe('${hookName}', () => {
    it('should initialize correctly', async () => {
        await init();
        expect(HookSystem.on.mock.calls.length + HookSystem.filter.mock.calls.length).toBeGreaterThan(0);
    });
});
`
