import { fragment } from '@nexical/generator';

declare const middlewarePath: string;
declare const moduleName: string;
declare const models: any[];

export default fragment/* ts */`
import { describe, it, expect, vi, beforeEach } from 'vitest';
import { onRequest } from '${middlewarePath}';
import { db } from '@/lib/core/db';

vi.mock('@/lib/core/db', () => {
    const mockModelProps = { id: '1', status: 'ACTIVE', email: 'test@example.com' };
    const mockModel = {
        findUnique: vi.fn().mockResolvedValue(mockModelProps),
        findFirst: vi.fn().mockResolvedValue(mockModelProps),
        update: vi.fn().mockResolvedValue(mockModelProps),
    };
    return {
        db: new Proxy({}, {
            get: (target: Record<string, unknown>, prop: string): unknown => {
                if (typeof prop === 'string' && !prop.startsWith('$')) {
                    return mockModel;
                }
                return target[prop];
            }
        })
    };
});

describe('Middleware: ${moduleName}', () => {
    let mockContext: Record<string, unknown>;
    let mockNext: vi.Mock;

    beforeEach(() => {
        vi.clearAllMocks();
        mockNext = vi.fn().mockResolvedValue(new Response());
        mockContext = {
            url: new URL('http://localhost/api/test'),
            request: {
                headers: new Headers(),
            },
            locals: {
                session: {
                    get: vi.fn(),
                },
            },

            cookies: {
                get: vi.fn(),
            },
        };
    });

    it('should be defined', () => {
        expect(onRequest).toBeDefined();
    });

    it('should call next() for public routes', async () => {
        mockContext.url = new URL('http://localhost/api/health');
        await onRequest(mockContext as unknown as any, mockNext as unknown as any);
        expect(mockNext).toHaveBeenCalled();
    });

    \${models.some(m => m.actor?.strategy === 'login' || m.actor?.validStatus) ? \`
    it('should map actor from session when valid session exists', async () => {
        (mockContext.locals as Record<string, any>).session.get.mockResolvedValue({ id: 'user-1', type: 'user', email: 'test@example.com' });

        await onRequest(mockContext as unknown as any, mockNext as unknown as any);
        expect(mockContext.locals.actor).toBeDefined();
        expect(mockContext.locals.actor.id).toBe('user-1');
        expect(mockNext).toHaveBeenCalled();
    });
    \` : ''}

    \${models.filter(m => m.actor?.prefix).map(m => \`
    it('should map actor from API Key with prefix \${m.actor.prefix} when valid key exists', async () => {
        const tokenModel = '\${m.actor.fields?.tokenModel || m.name.charAt(0).toLowerCase() + m.name.slice(1)}';
        const actorModel = '\${m.name.charAt(0).toLowerCase() + m.name.slice(1)}';
        
        mockContext.request.headers.set('Authorization', 'Bearer \${m.actor.prefix}valid-key');
        
        // Mock the token lookup
        vi.mocked((db as unknown as Record<string, unknown>)[tokenModel].findFirst).mockResolvedValue({
            id: 'token-1',
            [actorModel]: {
                id: 'actor-1',
                type: '\${m.actor.name || m.name.toLowerCase()}',
                name: 'Test Actor',
                status: 'ACTIVE'
            }
        });

        await onRequest(mockContext as unknown as any, mockNext as unknown as any);
        expect(mockContext.locals.actor).toBeDefined();
        expect(mockContext.locals.actor.id).toBe('actor-1');
        expect(mockNext).toHaveBeenCalled();
    });
    \`).join('\n')}

    it('should proceed even if unauthorized (Bouncer logic)', async () => {
        mockContext.request.headers.set('Authorization', 'Bearer invalid');
        await onRequest(mockContext as unknown as any, mockNext as unknown as any);
        expect(mockNext).toHaveBeenCalled();
    });
});
`
