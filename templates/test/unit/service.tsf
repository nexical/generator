import { fragment } from '@nexical/generator';

declare const serviceName: string;
declare const servicePath: string;
declare const tests: string;

export default fragment/* ts */`
import { beforeEach, describe, expect, it, vi } from 'vitest';
import { ${serviceName} } from '${servicePath}';
import { db } from '@/lib/core/db';
import { Logger } from '@/lib/core/logger';

vi.mock('@/lib/core/config', () => ({
  config: {
    PUBLIC_API_URL: 'http://localhost:3000',
    NODE_ENV: 'test',
  },
  createConfig: vi.fn().mockImplementation((schema) => ({
    parse: vi.fn().mockImplementation((d) => d),
    ...schema,
  })),
  getProcessEnv: vi.fn().mockImplementation((k) => k),
}));

vi.mock('@/lib/core/db', () => {
    const mockModelProps = {
        id: '1',
        type: 'TASK',
        email: 'test@example.com',
        status: '${defaultStatus}',
        name: 'Test Name',
        userId: 'ne_pat_test',
        teamId: 'team-1',
        actorId: 'ne_pat_test',
        actorType: 'user',
        lockedBy: 'ne_pat_test',
        payload: {},
        capabilities: [],
        progress: 0,
        retryCount: 0,
        maxRetries: 3,
        originalJobId: '1',
        reason: 'Test Reason',
    };

    const isExistenceCheck = (where: any): boolean => {
        if (!where) return false;
        const fields = [
        'email',
        'username',
        'teamId_userId',
        'userId_teamId',
        'teamId_email',
        'email_teamId',
        'token',
      ];
  const whereKeys = Object.keys(where);
        if (whereKeys.some((k) => fields.includes(k))) return true;
        if (whereKeys.some((k) => k.includes('_'))) return true;
        if (where.OR && Array.isArray(where.OR)) return where.OR.some((c: any) => isExistenceCheck(c));
        if (where.AND && Array.isArray(where.AND)) return where.AND.some((c: any) => isExistenceCheck(c));
        if (where.userId && where.teamId) return true;
        return false;
    };

    const mockModel = {
        findMany: vi.fn().mockResolvedValue([mockModelProps]),
        findUnique: vi.fn().mockImplementation((args: any) => {
            if (isExistenceCheck(args?.where) && !args?.where?.id) return null;
            return {
                ...mockModelProps,
                ...args?.where,
            };
        }),
        findFirst: vi.fn().mockImplementation((args: any) => {
            if (isExistenceCheck(args?.where) && !args?.where?.id) return null;
            return {
                ...mockModelProps,
                ...args?.where,
            };
        }),
        create: vi.fn().mockResolvedValue(mockModelProps),
        update: vi.fn().mockResolvedValue(mockModelProps),
        delete: vi.fn().mockResolvedValue(mockModelProps),
        count: vi.fn().mockResolvedValue(1),
        upsert: vi.fn().mockResolvedValue(mockModelProps),
        updateMany: vi.fn().mockResolvedValue({ count: 1 }),
        deleteMany: vi.fn().mockResolvedValue({ count: 1 }),
        groupBy: vi.fn().mockResolvedValue([{ _count: { id: 1 }, status: 'ACTIVE' }]),
        aggregate: vi.fn().mockResolvedValue({ _count: { id: 1 }, _avg: { value: 0 } }),
        ...mockModelProps,
    };

    const handler = {
        get: (target: any, prop: string): any => {
            if (prop === '$transaction') {
                return vi.fn().mockImplementation(async (input) => {
                    if (Array.isArray(input)) return Promise.all(input);
                    return typeof input === 'function' ? input(new Proxy({}, handler)) : input;
                });
            }
            if (typeof prop === 'string' && !prop.startsWith('$')) {
                return mockModel;
            }
            return target[prop];
        },
    };

    return {
        db: new Proxy({}, handler),
    };
});

vi.mock('@/lib/core/logger', () => ({
    Logger: {
        error: vi.fn(),
        info: vi.fn(),
        warn: vi.fn(),
        debug: vi.fn(),
    },
}));

vi.mock('@/lib/modules/hooks', () => ({
    HookSystem: {
        dispatch: vi.fn().mockResolvedValue(undefined),
        filter: vi.fn().mockImplementation((name, data) => Promise.resolve(data)),
        on: vi.fn(),
    },
}));

describe('${serviceName}', () => {
    beforeEach(() => {
        vi.clearAllMocks();
    });

    ${tests}
});
`
